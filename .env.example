# lycloud4A 环境变量示例
# 复制为 .env 后按需修改；一键脚本会自动生成安全的 SECRET_KEY / VAULT_MASTER_KEY。
# 说明见 docs/deployment.md

# ── 运行环境 ──────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=please-change-me-openssl-rand-hex-32

# ── 会话密钥（密码托管，丢失将无法解密现有密文）──
VAULT_MASTER_KEY=
VAULT_KEY_FAIL_MODE=fail

# ── 数据库（默认 SQLite，位于数据卷内；可切 PostgreSQL）──
# DATABASE_URL=sqlite:///./data/4a.db
# DATABASE_URL=postgresql://4a:password@postgres:5432/4a

# ── 对外端口（docker compose 使用）─────────────────
APP_PORT=8000

# ── CORS（后端同时托管前端时同源，无需配置；前后端分域名时填写）──
# CORS_ORIGINS=https://iam.corp.example.com

# ── 引导管理员（仅首次建库生效）────────────────────
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_EMAIL=admin@corp.example.com

# ── 密码轮换调度 ──────────────────────────────────
ROTATION_SCHEDULER_ENABLED=true
ROTATION_CHECK_CRON=0 2 * * *
