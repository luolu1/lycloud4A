[Unit]
Description=4A Platform Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=4a
Group=4a
WorkingDirectory=/opt/4a-platform/backend
EnvironmentFile=/opt/4a-platform/backend/.env
ExecStart=/opt/4a-platform/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/4a-platform/backend/data

[Install]
WantedBy=multi-user.target
