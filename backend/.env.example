# ── 4A 平台后端环境变量（复制为 .env 后修改）──────────────
# 安全提示：.env 必须 chmod 600，且绝不提交版本库

# 应用
APP_NAME="4A Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# 数据库：默认 SQLite（极简运维）；生产可改 PostgreSQL
DATABASE_URL=sqlite:///./data/4a.db
# DATABASE_URL=postgresql+psycopg2://four_a:CHANGE_ME@postgres:5432/four_a

# JWT / 会话
# 生成：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# 密码策略
PASSWORD_MIN_LENGTH=12

# 密码托管主密钥（Fernet key，32 bytes base64）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=CHANGE_ME_fernet_key
# Vault 无法解密时的策略：fail | warn
VAULT_KEY_FAIL_MODE=fail

# 登录防爆破
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# CORS（前端地址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 自动轮换调度
ROTATION_SCHEDULER_ENABLED=true
ROTATION_CHECK_CRON=0 2 * * *

# 首个超级管理员（仅 seed 时使用）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_EMAIL=admin@corp.example.com
